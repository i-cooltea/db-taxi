# DB-Taxi Environment Configuration
# Copy this file to .env and update with your values:
#   cp .env.example .env
#
# docker compose (docker-compose.yml / docker-compose.prod.yml) reads this
# file automatically to substitute variables in the compose files.

# ============================================
# Application Configuration
# ============================================
# Host port for the Web UI (container port is always 8080)
APP_PORT=8080

# ============================================
# Built-in MySQL (docker-compose.yml only)
# ============================================
# Ignored when connecting to an external MySQL (docker-compose.prod.yml)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=myapp
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# Host port mapped to the built-in MySQL (container port is always 3306)
MYSQL_PORT=13306

# ============================================
# Database Configuration
# ============================================
# Primary database connection (used by the db-taxi application)
# Keep "mysql" to use the built-in MySQL of docker-compose.yml;
# set an external host address to connect to your own MySQL server
DB_HOST=mysql
DB_PORT=3306

# With the built-in MySQL use root / MYSQL_ROOT_PASSWORD,
# or appuser / MYSQL_PASSWORD (must match the MYSQL_* settings above)
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=myapp
DB_SSL=false

# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_QUERY_TIMEOUT=30s

# ============================================
# Server Configuration
# ============================================
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# ============================================
# Logging Configuration
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, text
LOG_FORMAT=json

# Log output: stdout, stderr, or file path
LOG_OUTPUT=stdout

# ============================================
# Security Configuration
# ============================================
SESSION_TIMEOUT=30m
READ_ONLY_MODE=false
ENABLE_AUDIT=true

# ============================================
# Sync System Configuration
# ============================================
# Enable/disable sync system
SYNC_ENABLED=true

# Maximum number of concurrent sync jobs
SYNC_MAX_CONCURRENCY=5

# Batch size for bulk operations
SYNC_BATCH_SIZE=1000

# Retry configuration
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=30s

# Job timeout
SYNC_JOB_TIMEOUT=1h

# History cleanup age
SYNC_CLEANUP_AGE=720h
